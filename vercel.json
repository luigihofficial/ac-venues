{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/survey-send", "schedule": "0 13 * * *" },
    { "path": "/api/sheet-send", "schedule": "0 14 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
